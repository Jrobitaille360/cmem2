# =============================================================================
# Configuration ICS Calendar Plugin
# Fichier d'environnement pour le module de calendriers ICS
# =============================================================================


# -----------------------------------------------------------------------------
# INFORMATIONS GÉNÉRALES
# -----------------------------------------------------------------------------
ICS_PLUGIN_NAME=ICS Calendar
ICS_VERSION=1.0.0
ICS_AUTHOR=CMEM Team

# -----------------------------------------------------------------------------
# LIMITES ET QUOTAS
# -----------------------------------------------------------------------------
ICS_MAX_CALENDARS_PER_USER=100
ICS_MAX_EVENTS_PER_CALENDAR=10000
ICS_MAX_ATTENDEES_PER_EVENT=100
ICS_MAX_CALENDAR_TITLE_LENGTH=255
ICS_MAX_EVENT_TITLE_LENGTH=255
ICS_MAX_DESCRIPTION_LENGTH=1000

# -----------------------------------------------------------------------------
# CONFIGURATION TIMEZONE
# -----------------------------------------------------------------------------
ICS_DEFAULT_TIMEZONE=America/Montreal

# -----------------------------------------------------------------------------
# FONCTIONNALITÉS ACTIVÉES/DÉSACTIVÉES
# -----------------------------------------------------------------------------
# Partage
ICS_ENABLE_PUBLIC_SHARING=true
ICS_ENABLE_USER_SHARING=true
ICS_ENABLE_EMAIL_SHARING=false

# Fonctionnalités événements
ICS_ENABLE_RECURRENCE=true
ICS_ENABLE_ATTENDEES=true
ICS_ENABLE_ALL_DAY_EVENTS=true
ICS_ENABLE_REMINDERS=false

# Import/Export
ICS_ENABLE_IMPORT=false
ICS_ENABLE_CALDAV=false

# -----------------------------------------------------------------------------
# URLS ET CHEMINS
# -----------------------------------------------------------------------------
# URL de base (si différente du BASE_URL principal)
# ICS_BASE_URL=http://localhost/cmem2_API

# Chemins personnalisés (optionnels)
ICS_PUBLIC_PATH=/calendar/
ICS_PRIVATE_PATH=/calendars/

# -----------------------------------------------------------------------------
# SÉCURITÉ ET VALIDATION
# -----------------------------------------------------------------------------
ICS_SHARE_TOKEN_LENGTH=64
ICS_VALIDATE_EMAIL_FORMAT=true
ICS_VALIDATE_TIMEZONE=true
ICS_VALIDATE_DATETIME_FORMAT=true

# Rate limiting (requêtes par heure par utilisateur)
ICS_RATE_LIMIT_CREATE_CALENDAR=10
ICS_RATE_LIMIT_CREATE_EVENT=100
ICS_RATE_LIMIT_ICS_DOWNLOAD=1000

# -----------------------------------------------------------------------------
# PERFORMANCE ET CACHE
# -----------------------------------------------------------------------------
ICS_ENABLE_CACHE=true
ICS_CACHE_TTL=3600
ICS_DEFAULT_EVENTS_PER_PAGE=50
ICS_MAX_EVENTS_PER_PAGE=200

# -----------------------------------------------------------------------------
# COMPATIBILITÉ CLIENTS
# -----------------------------------------------------------------------------
ICS_GOOGLE_CALENDAR_COMPAT=true
ICS_OUTLOOK_COMPAT=true
ICS_APPLE_CALENDAR_COMPAT=true
ICS_THUNDERBIRD_COMPAT=true

# -----------------------------------------------------------------------------
# NOTIFICATIONS (si module disponible)
# -----------------------------------------------------------------------------
ICS_ENABLE_NOTIFICATIONS=false
ICS_NOTIFY_ON_INVITE=true
ICS_NOTIFY_ON_UPDATE=true

# -----------------------------------------------------------------------------
# LOGS ET DEBUG
# -----------------------------------------------------------------------------
ICS_LOG_ENABLED=true
ICS_LOG_LEVEL=INFO
ICS_DEBUG_MODE=false
ICS_DEBUG_GENERATE_ICS=false

# -----------------------------------------------------------------------------
# CONFIGURATION AVANCÉE
# -----------------------------------------------------------------------------
# Format et standards
ICS_RFC_VERSION=5545
ICS_PRODID=-//CMEM Calendar//FR
ICS_CALSCALE=GREGORIAN

# Couleur par défaut
ICS_DEFAULT_COLOR=#3174ad