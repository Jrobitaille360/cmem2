{
    "name": "ICS Calendar",
    "version": "1.0.0",
    "description": "Module de gestion des calendriers ICS/iCalendar avec support CalDAV RFC 5545 et synchronisation bidirectionnelle",
    "author": "CMEM Team",
    "namespace": "ICS",
    "main_class": "ICS\\CalendarPlugin",
    "min_cmem_version": "1.3.0",
    "status": "active",
    "dependencies": {
        "cmem2_core": ">=1.3.0"
    },
    "routes": {
        "prefix": "/calendars",
        "public_routes": [
            "/calendar/{token}.ics",
            "/caldav/"
        ],
        "auth_routes": [
            "/calendars",
            "/calendars/{id}",
            "/calendars/{id}/events",
            "/calendars/{id}/share",
            "/caldav/calendars/{user_id}/{calendar_id}/"
        ]
    },
    "route_handlers": {
        "public": "ICS\\Routing\\RouteHandlers\\CalendarPublicRoute",
        "authenticated": "ICS\\Routing\\RouteHandlers\\CalendarRouteHandler",
        "caldav": "ICS\\Routing\\RouteHandlers\\CalDAVRouteHandler"
    },
    "database": {
        "tables": [
            "calendars",
            "calendar_events",
            "calendar_shares",
            "caldav_sync_log",
            "caldav_locks"
        ],
        "migrations_path": "docs_ICS/"
    },
    "permissions": [
        "calendar.create",
        "calendar.read",
        "calendar.update", 
        "calendar.delete",
        "calendar.share",
        "event.create",
        "event.read",
        "event.update",
        "event.delete",
        "caldav.sync"
    ],
    "config": {
        "max_calendars_per_user": 100,
        "max_events_per_calendar": 10000,
        "default_timezone": "America/Montreal",
        "enable_public_sharing": true,
        "enable_user_sharing": true,
        "enable_caldav": true,
        "caldav_url_base": "/caldav/"
    },
    "features": {
        "ics_export": true,
        "caldav_sync": true,
        "recurrence_support": true,
        "attendees_support": true,
        "timezone_support": true,
        "compatible_with": [
            "Google Calendar",
            "Microsoft Outlook",
            "Apple Calendar",
            "Mozilla Thunderbird",
            "DAVx5 (Android)"
        ]
    },
    "assets": {
        "js": ["assets/calendar.js"],
        "css": ["assets/calendar.css"]
    },
    "hooks": {
        "user_deleted": "ICS\\Hooks\\UserDeletedHook",
        "before_calendar_create": "ICS\\Hooks\\BeforeCalendarCreateHook"
    }
}