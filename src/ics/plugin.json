{
    "name": "ICS Calendar",
    "version": "1.0.0",
    "description": "Module de gestion des calendriers ICS avec support complet RFC 5545",
    "author": "CMEM Team",
    "namespace": "ICS",
    "main_class": "ICS\\CalendarPlugin",
    "min_cmem_version": "1.3.0",
    "status": "active",
    "dependencies": {
        "cmem2_core": ">=1.3.0"
    },
    "routes": {
        "prefix": "/calendars",
        "public_routes": ["/calendar/{token}.ics"],
        "auth_routes": [
            "/calendars",
            "/calendars/{id}",
            "/calendars/{id}/events",
            "/calendars/{id}/share"
        ]
    },
    "route_handlers": {
        "public": "ICS\\Routing\\RouteHandlers\\CalendarPublicRoute",
        "authenticated": "ICS\\Routing\\RouteHandlers\\CalendarRouteHandler"
    },
    "database": {
        "tables": ["calendars", "calendar_events", "calendar_shares"],
        "migrations_path": "docs_ICS/migrations/"
    },
    "permissions": [
        "calendar.create",
        "calendar.read",
        "calendar.update", 
        "calendar.delete",
        "calendar.share",
        "event.create",
        "event.read",
        "event.update",
        "event.delete"
    ],
    "config": {
        "max_calendars_per_user": 100,
        "max_events_per_calendar": 10000,
        "default_timezone": "America/Montreal",
        "enable_public_sharing": true,
        "enable_user_sharing": true
    },
    "assets": {
        "js": ["assets/calendar.js"],
        "css": ["assets/calendar.css"]
    },
    "hooks": {
        "user_deleted": "ICS\\Hooks\\UserDeletedHook",
        "before_calendar_create": "ICS\\Hooks\\BeforeCalendarCreateHook"
    }
}