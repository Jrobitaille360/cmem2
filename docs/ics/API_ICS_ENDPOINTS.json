          }
        },
        {
          "method": "GET",
          "path": "/calendars/{id}/journals",
          "description": "Lister les entrées de journal",
          "params": { "id": "integer (required)" },
          "response": "{ journals: Array, count: integer }"
        },
        {
          "method": "GET",
          "path": "/calendars/{id}/journals/{journalId}",
          "description": "Obtenir une entrée de journal spécifique",
          "params": { "id": "integer (required)", "journalId": "integer (required)" },
          "response": "Journal object",
          "errors": { "404": "Journal non trouvé" }
        },
        {
          "method": "PUT",
          "path": "/calendars/{id}/journals/{journalId}",
          "description": "Mettre à jour une entrée de journal",
          "params": { "id": "integer (required)", "journalId": "integer (required)" },
          "body": {
            "summary": "string (optional)",
            "description": "string (optional)",
            "dtstart": "date ou datetime (optional)",
            "status": "string (optional) - DRAFT | FINAL | CANCELLED",
            "categories": "array of strings (optional)"
          },
          "response": "Journal object mis à jour",
          "errors": { "403": "Permission insuffisante", "404": "Non trouvé" }
        },
        {
          "method": "DELETE",
          "path": "/calendars/{id}/journals/{journalId}",
          "description": "Supprimer une entrée de journal (soft delete)",
          "params": { "id": "integer (required)", "journalId": "integer (required)" },
          "response": "{ journal_id, deleted_at }",
          "errors": { "403": "Permission insuffisante", "404": "Non trouvé" }
        }
      ]
    },
    "freebusy": {
      "description": "Disponibilités CalDAV VFREEBUSY (RFC 5545 §3.6.4) — Phase 5.3",
      "auth_required": true,
      "routes": [
        {
          "method": "GET",
          "path": "/calendars/{id}/freebusy",
          "description": "Obtenir les plages occupées d'un calendrier — agrège les événements TRANSP=OPAQUE",
          "params": { "id": "integer (required)" },
          "query": {
            "start": "date (required) - Début de la période YYYY-MM-DD",
            "end": "date (required) - Fin de la période YYYY-MM-DD"
          },
          "response": "{ freebusy: [{ dtstart, dtend }], calendar_id, period: { start, end } }",
          "notes": "Requiert TRANSP (Phase 2 — 2.4). Seuls les événements OPAQUE sont inclus. Exposé également via REPORT CalDAV.",
          "errors": {
            "400": "start ou end manquant/invalide, ou start > end",
            "403": "Accès non autorisé",
            "404": "Calendrier non trouvé"
          }
        }
      ]
    },
    "notifications": {
      "description": "Gestion des notifications email et réponses RSVP (iTIP)",
      "base_path": "/notifications",
      "auth_required": true,
      "routes": [
        {
          "method": "GET",
          "path": "/notifications/email",
          "description": "Lister les notifications email planifiées de l'utilisateur"
        },
        {
          "method": "POST",
          "path": "/notifications/email/test",
          "description": "Envoyer un email de test SMTP",
          "body": { "email": "string (optional) — destinataire (défaut: email du compte)" }
        },
        {
          "method": "DELETE",
          "path": "/notifications/email/{id}",
          "description": "Annuler une notification email planifiée",
          "params": { "id": "integer (required)" }
        },
        {
          "method": "POST",
          "path": "/notifications/send-email",
          "description": "Envoyer immédiatement un rappel email pour une occurrence",
          "body": { "event_id": "integer (required)", "occurrence_date": "string YYYY-MM-DD (required)" }
        },
        {
          "method": "POST",
          "path": "/notifications/attendee-reply",
          "description": "Enregistrer la réponse RSVP d'un participant — iTIP METHOD:REPLY (Phase 3)",
          "body": {
            "event_id": "integer (required)",
            "attendee_email": "string (required) — email du participant",
