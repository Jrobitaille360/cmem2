            "dtstart": "date ou datetime (optional) - Date du journal",
            "status": "string (optional) - DRAFT | FINAL | CANCELLED (défaut: DRAFT)",
            "categories": "array of strings (optional)",
            "url": "string (optional)",
            "timezone": "string (optional, default: America/Montreal)"
          },
          "response": "Journal object avec uid (UUID v4)",
          "errors": {
            "400": "summary manquant ou invalide",
