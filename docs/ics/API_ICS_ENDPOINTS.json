{
  "api": {
    "name": "ICS Calendar API",
    "version": "2.0.0",
    "description": "Module de gestion des calendriers ICS/iCalendar avec support CalDAV RFC 5545 et synchronisation bidirectionnelle. Couvre Ph1 (sabre/vobject) · Ph2 (VEVENT enrichi) · Ph3 (ATTENDEE/ORGANIZER/iTIP) · Ph4 (EXDATE/RDATE/VALARM/DURATION) · Ph5 (VTODO/VJOURNAL/VFREEBUSY) · Import ICS upsert par UID",
    "generated": "2026-04-03",
    "base_url": "/calendars",
    "authentication": {
      "types": ["JWT_BEARER"],
      "header": "Authorization: Bearer {jwt_token}",
      "description": "Authentification JWT requise pour tous les endpoints sauf téléchargement ICS public"
    }
  },
  "endpoints": {
    "public": {
      "description": "Endpoints accessibles sans authentification",
      "base_path": "/",
      "auth_required": false,
      "routes": [
        {
          "method": "GET",
          "path": "/calendar/{token}.ics",
          "description": "Télécharger un fichier ICS public via token de partage",
          "params": {
            "token": "string (required) - Token de partage du calendrier"
          },
          "response": "Fichier ICS au format iCalendar"
        },
        {
          "method": "OPTIONS",
          "path": "/caldav/",
          "description": "Discovery CalDAV (OPTIONS request)",
          "response": "Headers CalDAV supportés"
        }
      ]
    },
    "calendars": {
      "description": "Gestion des calendriers",
      "base_path": "/calendars",
      "auth_required": true,
      "routes": [
        {
          "method": "POST",
          "path": "/calendars",
          "description": "Créer un nouveau calendrier",
          "body": {
            "title": "string (required) - Titre du calendrier, max 100 caractères",
            "description": "string (optional) - Description du calendrier, max 1000 caractères",
            "visibility": "string (optional, default: private) - Visibilité ('public' ou 'private')",
            "max_members": "integer (optional, default: 1000) - Nombre maximum de membres (1-1000)",
            "color": "string (optional) - Couleur en nom ou hex (#RRGGBB), doit être une couleur valide",
            "timezone": "string (optional, default: America/Montreal) - Timezone valide selon IANA"
          },
          "response": "Objet calendrier créé avec ID"
        },
        {
          "method": "GET",
          "path": "/calendars",
          "description": "Récupérer tous les calendriers de l'utilisateur",
          "response": "Liste des calendriers avec métadonnées"
        },
        {
          "method": "PUT",
          "path": "/calendars/{id}",
          "description": "Mettre à jour un calendrier",
          "params": {
            "id": "integer (required) - ID du calendrier"
          },
          "body": {
            "title": "string (optional) - Nouveau titre, max 100 caractères",
            "description": "string (optional) - Nouvelle description, max 1000 caractères",
            "visibility": "string (optional) - Nouvelle visibilité ('public' ou 'private')",
            "max_members": "integer (optional) - Nouveau max membres (1-1000)",
            "color": "string (optional) - Nouvelle couleur, doit être valide",
            "timezone": "string (optional) - Nouveau timezone valide"
          },
          "response": "Calendrier mis à jour"
        },
        {
          "method": "DELETE",
          "path": "/calendars/{id}",
          "description": "Supprimer un calendrier (soft delete)",
          "params": {
            "id": "integer (required) - ID du calendrier"
          },
          "response": "Confirmation de suppression"
        },
        {
          "method": "DELETE",
          "path": "/calendars/{id}/hard",
          "description": "Supprimer définitivement un calendrier",
          "params": {
            "id": "integer (required) - ID du calendrier"
          },
          "response": "Confirmation de suppression définitive"
        },
        {
          "method": "GET",
          "path": "/calendars/{id}/ics",
          "description": "Télécharger le fichier ICS d'un calendrier (authentifié)",
          "params": {
            "id": "integer (required) - ID du calendrier"
          },
          "response": "Fichier ICS au format iCalendar"
        },
        {
          "method": "POST",
          "path": "/calendars/{id}/ics/import",
          "description": "Mettre à jour un calendrier existant depuis un fichier ICS (upsert par UID RFC 5545 §3.8.4.7). Met à jour les métadonnées (X-WR-CALNAME, X-WR-CALDESC, X-WR-TIMEZONE) et upserte les VEVENT : mise à jour si l'UID existe déjà, création sinon.",
          "params": {
            "id": "integer (required) - ID du calendrier cible"
          },
          "body": {
            "icsfile": "file (required) - Fichier ICS multipart/form-data"
          },
          "response": "{ id, title, timezone, events_created: integer, events_updated: integer }",
          "errors": {
            "400": "Aucun fichier ICS envoyé ou erreur d'upload",
            "403": "Accès non autorisé (lecture seule ou non membre)",
            "404": "Calendrier non trouvé",
            "500": "Erreur lors de la mise à jour"
          },
          "notes": "Nécessite accès en écriture (propriétaire ou partage write). UID fourni et conforme UUID v4 préservé ; UID absent ou non conforme remplacé par un nouveau UUID v4."
        },
        {
          "method": "POST",
          "path": "/calendars/{id}/share",
          "description": "Partager un calendrier avec un token public",
          "params": {
            "id": "integer (required) - ID du calendrier"
          },
          "body": {
            "email": "string (optional) - Email du destinataire",
            "message": "string (optional) - Message personnalisé"
          },
          "response": "Token de partage généré"
        },
        {
          "method": "GET",
          "path": "/calendars/{id}/share",
          "description": "Récupérer les partages d'un calendrier",
          "params": {
            "id": "integer (required) - ID du calendrier"
          },
          "body": {},
          "response": "Liste des partages du calendrier"
        },
        {
          "method": "DELETE",
          "path": "/calendars/{id}/share",
          "description": "Supprimer le partage d'un calendrier",
          "params": {
            "id": "integer (required) - ID du calendrier"
          },
          "response": "Confirmation de suppression du partage"
        },
        {
          "method": "POST",
          "path": "/calendars/import",
          "description": "Créer un nouveau calendrier complet depuis un fichier ICS (import initial)",
          "body": {
            "icsfile": "file (required) - Fichier ICS multipart/form-data"
          },
          "response": "Calendrier créé avec événements importés",
          "notes": "Crée un nouveau calendrier. Pour mettre à jour un calendrier existant, utiliser POST /calendars/{id}/ics/import"
        }
      ]
    },
    "events": {
      "description": "Gestion des événements",
      "base_path": "/calendars/{id}/events",
      "auth_required": true,
      "routes": [
        { "method": "POST", "path": "/calendars/{id}/events",
          "description": "Créer un événement dans un calendrier",
          "params": {
            "id": "integer (required) - ID du calendrier"
          },
          "body": {
            "title": "string (required) - Titre de l'événement",
            "start_datetime": "string (required) - Date/heure de début (ISO 8601 ou YYYY-MM-DD)",
            "end_datetime": "string (required*) - Date/heure de fin (* exclusif avec duration)",
            "description": "string (optional) - Description",
            "all_day": "boolean (optional, default: false) - Événement toute la journée",
            "location": "string (optional) - Lieu",
            "organizer_email": "string (optional) - Email de l'organisateur — exporté ORGANIZER;mailto:... (Phase 3)",
            "organizer_name": "string (optional) - Nom affiché de l'organisateur (CN) (Phase 3)",
            "attendees": "array (optional) - [{email, name, role, partstat, rsvp, cutype}] (Phase 3)",
            "attendees[].email": "string (required) - Adresse email du participant",
            "attendees[].name": "string (optional) - Nom affiché (CN) — exporté ATTENDEE;CN=...",
            "attendees[].role": "string (optional) - CHAIR | REQ-PARTICIPANT | OPT-PARTICIPANT | NON-PARTICIPANT",
            "attendees[].partstat": "string (optional) - NEEDS-ACTION | ACCEPTED | DECLINED | TENTATIVE | DELEGATED",
            "attendees[].rsvp": "boolean (optional) - true = réponse attendue",
            "attendees[].cutype": "string (optional) - INDIVIDUAL | GROUP | RESOURCE | ROOM | UNKNOWN",
            "recurrence_rule": "string (optional) - Règle de récurrence RRULE valide",
            "status": "string (optional, default: confirmed) - Statut ('confirmed', 'tentative', 'cancelled')",
            "timezone": "string (optional) - Timezone de l'événement",
            "priority": "integer (optional) - RFC 5545 PRIORITY: 0=non défini, 1=haute, 5=normale, 9=basse (Phase 2)",
            "class": "string (optional) - PUBLIC | PRIVATE | CONFIDENTIAL (Phase 2)",
            "transp": "string (optional) - OPAQUE | TRANSPARENT (Phase 2)",
            "categories": "array of strings (optional) - ex: ['Travail','Réunion'] (Phase 2)",
            "geo_lat": "decimal (optional) - latitude WGS84 -90..90 — requis si geo_lng fourni (Phase 2)",
            "geo_lng": "decimal (optional) - longitude WGS84 -180..180 — requis si geo_lat fourni (Phase 2)",
            "attachments": "array (optional) - [{url, mime_type}] ou [{data_base64, mime_type}] (Phase 2)",
            "rdate": "string (optional) - Phase 4 — RDATE : dates additionnelles (datetimes locales CSV)",
            "related_to": "string (optional) - Phase 4 — UID RFC 5545 de l'événement parent (RELATED-TO;RELTYPE=PARENT)",
            "duration": "string (optional) - Phase 4 — durée ISO 8601 ex: PT1H30M — exclusif avec end_datetime",
            "notifications": "array (optional) - [{type: EMAIL|DISPLAY, minutes_before: int}] — exportés BEGIN:VALARM (Phase 4)"
          },
          "response": "Événement créé avec ID"
        },
        { "method": "GET", "path": "/calendars/{id}/events",
          "description": "Récupérer les événements d'un calendrier",
          "params": {
            "id": "integer (required) - ID du calendrier"
          },
          "body": {
            "start": "string (optional) - Filtrer par date/heure de début (YYYY-MM-DD ou ISO 8601)",
            "end": "string (optional) - Filtrer par date/heure de fin (YYYY-MM-DD ou ISO 8601)",
            "last_update_after": "string (optional) - Récupérer les événements mis à jour après cette date/heure (ISO 8601)",
            "limit": "integer (optional) - Nombre maximum d'événements à retourner (par défaut 100)",
            "expand_multi_jour": "boolean (optional) - Si true(default), les événements multi-jours sont retournés avec chaque jour comme occurrence distincte"
          },
          "response": "Liste des événements avec détails"
        },
        {
          "method": "GET",
          "path": "/calendars/{id}/events/{eventId}",
          "description": "Récupérer un événement spécifique",
          "params": {
            "id": "integer (required) - ID du calendrier",
            "eventId": "integer (required) - ID de l'événement"
          },
          "response": "Détails de l'événement"
        },
        {
          "method": "PUT",
          "path": "/calendars/{id}/events/{eventId}",
          "description": "Mettre à jour un événement",
          "params": {
            "id": "integer (required) - ID du calendrier",
            "eventId": "integer (required) - ID de l'événement"
          },
          "body": {
            "title": "string (optional) - Nouveau titre",
            "start_datetime": "string (optional) - Nouvelle date/heure de début",
            "end_datetime": "string (optional) - Nouvelle date/heure de fin",
            "description": "string (optional) - Nouvelle description",
            "all_day": "boolean (optional) - Nouveau flag toute la journée",
            "location": "string (optional) - Nouveau lieu",
            "organizer_email": "string (optional) - Nouvel email organisateur (Phase 3)",
            "organizer_name": "string (optional) - Nouveau nom organisateur (Phase 3)",
            "attendees": "array (optional) - Nouveaux participants [{email, name, role, partstat, rsvp, cutype}] (Phase 3)",
            "recurrence_rule": "string (optional) - Nouvelle règle de récurrence",
            "status": "string (optional) - Nouveau statut",
            "timezone": "string (optional) - Nouveau timezone",
            "priority": "integer (optional) - 0–9 (Phase 2)",
            "class": "string (optional) - PUBLIC | PRIVATE | CONFIDENTIAL (Phase 2)",
            "transp": "string (optional) - OPAQUE | TRANSPARENT (Phase 2)",
            "categories": "array of strings (optional) (Phase 2)",
            "geo_lat": "decimal (optional) (Phase 2)",
            "geo_lng": "decimal (optional) (Phase 2)",
            "attachments": "array (optional) (Phase 2)",
            "rdate": "string (optional) - RDATE dates CSV (Phase 4)",
            "related_to": "string (optional) - UID parent (Phase 4)",
            "duration": "string (optional) - durée ISO 8601 (Phase 4)"
          },
          "response": "Événement mis à jour"
        },
        {
          "method": "DELETE",
          "path": "/calendars/{id}/events/{eventId}",
          "description": "Supprimer un événement (soft delete)",
          "params": {
            "id": "integer (required) - ID du calendrier",
            "eventId": "integer (required) - ID de l'événement"
          },
          "response": "Confirmation de suppression"
        },
        {
          "method": "DELETE",
          "path": "/calendars/{id}/events/{eventId}/hard",
          "description": "Supprimer définitivement un événement",
          "params": {
            "id": "integer (required) - ID du calendrier",
            "eventId": "integer (required) - ID de l'événement"
          },
          "response": "Confirmation de suppression définitive"
        },
        { "method": "GET", "path": "/calendars/{id}/events/{eventId}/occurrences",
          "description": "Obtenir les occurrences d'un événement récurrent",
          "params": {
            "id": "integer (required) - ID du calendrier",
            "eventId": "integer (required) - ID de l'événement récurrent"
          },
          "response": "Liste des occurrences avec dates"
        },
        { "method": "GET", "path": "/calendars/{id}/events/occurrences",
          "description": "Obtenir toutes les occurrences (récursives ou non) du calendrier entre deux dates",
          "params": {
            "id": "integer (required) - ID du calendrier"
          },
          "query_params": {
            "start_date": "string (optional) - Date de début (YYYY-MM-DD)",
            "end_date": "string (optional) - Date de fin (YYYY-MM-DD)"
          },
          "response": "Liste des occurrences avec dates"
        },
        {
          "method": "DELETE",
          "path": "/calendars/{id}/events/{eventId}/occurrences",
          "description": "Supprimer/annuler une occurrence d'événement récurrent",
          "params": {
            "id": "integer (required) - ID du calendrier",
            "eventId": "integer (required) - ID de l'événement récurrent"
          },
          "query_params": {
            "occurrence_id": "string (required) - ID de l'occurrence à annuler. for futur occurrences id>= this id",
            "scope": "optional|string|in:only_this,all_future,all - Portée de l'annulation (note all pour supprimer l'événement entier)"
          },
          "response": "Confirmation d'annulation de l'occurrence"
        },
        {
          "method": "PUT",
          "path": "/calendars/{id}/events/{eventId}/occurrences",
          "description": "Modifier une occurrence d'événement récurrent",
          "params": {
            "id": "integer (required) - ID du calendrier",
            "eventId": "integer (required) - ID de l'événement récurrent"
          },
          "query_params": {
            "occurrence_date": "string (required) - Date de l'occurrence à modifier (YYYY-MM-DD)"
          },
          "body": {
            "title": "string (optional) - Nouveau titre de l'occurrence",
            "description": "string (optional) - Nouvelle description",
            "location": "string (optional) - Nouveau lieu",
            "start_datetime": "string (optional) - Nouvelle date/heure de début",
            "end_datetime": "string (optional) - Nouvelle date/heure de fin",
            "scope": "optional|string|in:only_this,all_future,all - Portée de la modification"
          },
          "response": "Occurrence modifiée avec succès"
        }
      ]
    },
    "todos": {
      "description": "Tâches CalDAV VTODO (RFC 5545 §3.6.2) — Phase 5.1",
      "base_path": "/calendars/{id}/todos",
      "auth_required": true,
      "routes": [
        {
          "method": "POST",
          "path": "/calendars/{id}/todos",
          "description": "Créer une tâche VTODO dans un calendrier",
          "params": { "id": "integer (required)" },
          "body": {
            "title": "string (required) - Titre de la tâche (SUMMARY)",
            "description": "string (optional)",
            "due": "date ou datetime (optional) - Échéance DUE",
            "dtstart": "date ou datetime (optional) - DTSTART",
            "status": "string (optional) - NEEDS-ACTION | IN-PROCESS | COMPLETED | CANCELLED (défaut: NEEDS-ACTION)",
            "priority": "integer (optional) - 0=non défini, 1=haute, 5=normale, 9=basse",
            "percent_complete": "integer (optional) - 0–100",
            "location": "string (optional)",
            "categories": "array of strings (optional)",
            "url": "string (optional)",
            "timezone": "string (optional, default: America/Montreal)",
            "recurrence_rule": "string (optional) - Règle de récurrence RRULE valide (RFC 5545 §3.8.5.4) ex: FREQ=WEEKLY;BYDAY=MO,WE"
          },
          "response": "Todo object avec uid (UUID v4)",
          "errors": {
            "400": "title manquant ou invalide",
            "403": "Accès non autorisé"
          }
        },
        {
          "method": "GET",
          "path": "/calendars/{id}/todos",
          "description": "Lister les tâches d'un calendrier",
          "params": { "id": "integer (required)" },
          "response": "{ todos: Array, count: integer }"
        },
        {
          "method": "GET",
          "path": "/calendars/{id}/todos/{todoId}",
          "description": "Obtenir une tâche spécifique",
          "params": { "id": "integer (required)", "todoId": "integer (required)" },
          "response": "Todo object",
          "errors": { "404": "Tâche non trouvée" }
        },
        {
          "method": "PUT",
          "path": "/calendars/{id}/todos/{todoId}",
          "description": "Mettre à jour une tâche",
          "params": { "id": "integer (required)", "todoId": "integer (required)" },
          "body": {
            "title": "string (optional)",
            "description": "string (optional)",
            "due": "date ou datetime (optional)",
            "status": "string (optional)",
            "priority": "integer (optional)",
            "percent_complete": "integer (optional)",
            "recurrence_rule": "string (optional) - Règle de récurrence RRULE valide (RFC 5545 §3.8.5.4)"
          },
          "response": "Todo object mis à jour",
          "errors": { "403": "Permission insuffisante", "404": "Tâche non trouvée" }
        },
        {
          "method": "DELETE",
          "path": "/calendars/{id}/todos/{todoId}",
          "description": "Supprimer une tâche (soft delete)",
          "params": { "id": "integer (required)", "todoId": "integer (required)" },
          "response": "{ todo_id, deleted_at }",
          "errors": { "403": "Permission insuffisante", "404": "Non trouvé" }
        }
      ]
    },
    "journals": {
      "description": "Journaux CalDAV VJOURNAL (RFC 5545 §3.6.3) — Phase 5.2",
      "base_path": "/calendars/{id}/journals",
      "auth_required": true,
      "routes": [
        {
          "method": "POST",
          "path": "/calendars/{id}/journals",
          "description": "Créer une entrée de journal VJOURNAL",
          "params": { "id": "integer (required)" },
          "body": {
            "summary": "string (required) - Résumé du journal",
