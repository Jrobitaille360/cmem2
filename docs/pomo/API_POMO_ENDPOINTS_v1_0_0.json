{
  "api": {
    "name": "Pomo API",
    "version": "1.0.0",
    "description": "Plugin Pomodoro intégré dans cmem2 via le système de plugins. Couvre Ph1A (engagement MVP public) · Ph1B (support JWT) · Ph2 (sync cloud Premium) · Ph3 (abonnement Stripe)",
    "generated": "2026-04-02",
    "base_url": "/pomo",
    "authentication": {
      "types": ["NONE", "JWT_BEARER"],
      "header": "Authorization: Bearer {jwt_token}",
      "description": "Phase 1A : aucune auth. Phase 1B et 2 : JWT Bearer obtenu via POST /auth/login. Phase 3 : signature Stripe pour le webhook."
    },
    "notes": [
      "GET /health est fourni par cmem2 core (PublicRouteHandler) — non redéfini dans ce plugin",
      "L'inscription et la connexion utilisent les endpoints cmem2 existants : POST /users/register et POST /auth/login",
      "Toutes les routes sont préfixées /pomo/ pour éviter toute collision avec le core"
    ]
  },
  "endpoints": {
    "public": {
      "description": "Phase 1A — Endpoints accessibles sans authentification",
      "base_path": "/pomo",
      "auth_required": false,
      "routes": [
        {
          "method": "POST",
          "path": "/pomo/engagement",
          "description": "Soumettre un engagement MVP — waitlist (courriel) ou sondage (5 questions oui/non/peut-être). Chaque soumission identifie l'appareil via device_id.",
          "body": {
            "type": "string (required) — 'waitlist' | 'survey'",
            "device_id": "string (required) — UUID stable côté client, max 36 chars",
            "email": "string (required si type=waitlist) — courriel valide, 3–254 chars",
            "responses": "object (required si type=survey) — clés q1 à q5, valeurs 'yes' | 'no' | 'maybe'",
            "suggestion": "string (optional) — texte libre, si type=survey",
            "platform": "string (optional) — 'android' | 'ios' | 'web' | 'windows' | 'macos' | 'linux'",
            "language": "string (optional) — code langue, max 16 chars",
            "app_version": "string (optional) — ex. '1.0.0', max 32 chars",
            "build_number": "string (optional) — ex. '42', max 32 chars",
            "session_duration": "integer (optional) — durée de la session en secondes",
            "network_status": "string (optional) — 'online' | 'offline'",
            "timestamp_utc": "datetime (required) — horodatage ISO 8601 UTC côté client"
          },
          "response_success": {
            "http_status": 201,
            "body": {
              "success": true,
              "reference_id": "integer — ID de l'enregistrement créé"
            }
          },
          "errors": {
            "409": "type=waitlist — courriel déjà enregistré dans la waitlist",
            "422": "Erreur de validation — corps : {success: false, errors: [{field, code, message}]}"
          },
          "notes": [
            "type=waitlist : un seul enregistrement par courriel (doublon → 409)",
            "type=survey : plusieurs soumissions par device_id acceptées",
            "Les 5 questions du sondage sont identifiées par des clés fixes q1–q5"
          ]
        }
      ]
    },
    "support": {
      "description": "Phase 1B — Formulaire de support (actif quand SUPPORT_FORM_ENABLED=true)",
      "base_path": "/pomo",
      "auth_required": true,
      "routes": [
        {
          "method": "POST",
          "path": "/pomo/support",
          "description": "Soumettre un formulaire de support. Envoie un courriel à l'équipe et une confirmation à l'utilisateur. Enregistre la demande en DB avec un reference_id unique.",
          "headers": {
            "Authorization": "Bearer {jwt_token}"
          },
          "body": {
            "email": "string (required) — courriel de l'utilisateur, 3–254 chars",
            "message": "string (required) — corps du message support, non vide",
            "infos": {
              "description": "object (optional) — informations contextuelles de l'appareil",
              "device_id": "string (optional) — UUID stable de l'appareil",
              "platform": "string (optional) — 'android' | 'ios' | 'web' | 'windows' | 'macos' | 'linux'",
              "language": "string (optional) — code langue",
              "app_version": "string (optional) — version de l'application",
              "build_number": "string (optional) — numéro de build",
              "network_status": "string (optional) — 'online' | 'offline'",
              "timestamp_utc": "datetime (optional) — horodatage ISO 8601 UTC côté client"
            }
          },
          "response_success": {
            "http_status": 200,
            "body": {
              "success": true,
              "reference_id": "string — UUID de la demande créée",
              "mail_sent": "boolean — courriel support envoyé",
              "confirmation_sent": "boolean — courriel de confirmation envoyé à l'utilisateur"
            }
          },
          "errors": {
            "400": "Champs email ou message manquants / invalides",
            "401": "JWT manquant ou invalide",
            "403": "Fonctionnalité désactivée (SUPPORT_FORM_ENABLED=false)",
            "422": "Erreur de validation — corps : {success: false, errors: [{field, code, message}]}"
          }
        }
      ]
    },
    "sync": {
      "description": "Phase 2 — Sync cloud Premium. Stratégie de conflit : last-write-wins sur updated_at. Delta sync via paramètre ?since=ISO.",
      "base_path": "/pomo/sync",
      "auth_required": true,
      "routes": [
        {
          "method": "GET",
          "path": "/pomo/sync/sessions",
          "description": "Récupérer les sessions Pomodoro depuis une date (delta sync) ou toutes les sessions de l'utilisateur.",
          "headers": {
            "Authorization": "Bearer {jwt_token}"
          },
          "query": {
            "since": "datetime (optional) — ISO 8601 UTC — retourne uniquement les sessions modifiées après cette date"
          },
          "response_success": {
            "http_status": 200,
            "body": {
              "sessions": [
                {
                  "uuid": "string",
                  "timestamp_utc": "datetime",
                  "duration_sec": "integer",
                  "interruptions": "integer",
                  "task_uuid": "string | null",
                  "completed": "boolean",
                  "device_id": "string",
                  "deleted_at": "datetime | null",
                  "updated_at": "datetime",
                  "synced_at": "datetime",
                  "created_at": "datetime"
                }
              ]
            }
          },
          "errors": {
            "401": "JWT manquant ou invalide",
            "400": "Format de date invalide pour ?since"
          }
        },
        {
          "method": "POST",
          "path": "/pomo/sync/sessions",
          "description": "Envoyer un batch de sessions Pomodoro. Résolution de conflits : last-write-wins sur updated_at.",
          "headers": {
            "Authorization": "Bearer {jwt_token}"
          },
          "body": {
            "sessions": [
              {
                "uuid": "string (required) — UUID unique côté client",
                "timestamp_utc": "datetime (required) — ISO 8601 UTC",
                "duration_sec": "integer (required)",
                "interruptions": "integer (required)",
                "task_uuid": "string | null (optional)",
                "completed": "boolean (required)",
                "device_id": "string (required)",
                "deleted_at": "datetime | null (optional)",
                "updated_at": "datetime (required) — horodatage de dernière modification"
              }
            ]
          },
          "response_success": {
            "http_status": 200,
            "body": {
              "synced": "integer — nombre d'enregistrements traités",
              "conflicts_resolved": "integer — nombre de conflits résolus par last-write-wins"
            }
          },
          "errors": {
            "400": "Format de body invalide ou champs requis manquants",
            "401": "JWT manquant ou invalide",
            "422": "Erreur de validation sur un ou plusieurs enregistrements"
          }
        },
        {
          "method": "GET",
          "path": "/pomo/sync/tasks",
          "description": "Récupérer les tâches Pomodoro (delta sync avec ?since).",
          "headers": {
            "Authorization": "Bearer {jwt_token}"
          },
          "query": {
            "since": "datetime (optional) — ISO 8601 UTC"
          },
          "response_success": {
            "http_status": 200,
            "body": {
              "tasks": [
                {
                  "uuid": "string",
                  "title": "string",
                  "description": "string | null",
                  "priority": "integer (0–9)",
                  "status": "string",
                  "estimated_pomodoros": "integer | null",
                  "project_uuid": "string | null",
                  "deadline": "datetime | null",
                  "order_index": "integer",
                  "type": "string",
                  "device_id": "string",
                  "deleted_at": "datetime | null",
                  "updated_at": "datetime",
                  "synced_at": "datetime",
                  "created_at": "datetime"
                }
              ]
            }
          },
          "errors": {
            "401": "JWT manquant ou invalide",
            "400": "Format de date invalide pour ?since"
          }
        },
        {
          "method": "POST",
          "path": "/pomo/sync/tasks",
          "description": "Envoyer un batch de tâches. Résolution de conflits : last-write-wins sur updated_at.",
          "headers": {
            "Authorization": "Bearer {jwt_token}"
          },
          "body": {
            "tasks": [
              {
                "uuid": "string (required)",
                "title": "string (required) — max 255 chars",
                "description": "string | null (optional)",
                "priority": "integer (required) — 0–9",
                "status": "string (required) — max 32 chars",
                "estimated_pomodoros": "integer | null (optional)",
                "project_uuid": "string | null (optional)",
                "deadline": "datetime | null (optional)",
                "order_index": "integer (required)",
                "type": "string (required) — max 32 chars",
                "device_id": "string (required)",
                "deleted_at": "datetime | null (optional)",
                "updated_at": "datetime (required)"
              }
            ]
          },
          "response_success": {
            "http_status": 200,
            "body": {
              "synced": "integer",
              "conflicts_resolved": "integer"
            }
          },
          "errors": {
            "400": "Format de body invalide",
            "401": "JWT manquant ou invalide",
            "422": "Erreur de validation"
          }
        },
        {
          "method": "GET",
          "path": "/pomo/sync/projects",
          "description": "Récupérer les projets Pomodoro (delta sync avec ?since).",
          "headers": {
            "Authorization": "Bearer {jwt_token}"
          },
          "query": {
            "since": "datetime (optional) — ISO 8601 UTC"
          },
          "response_success": {
            "http_status": 200,
            "body": {
              "projects": [
                {
                  "uuid": "string",
                  "title": "string",
                  "description": "string | null",
                  "deadline": "datetime | null",
                  "device_id": "string",
                  "deleted_at": "datetime | null",
                  "updated_at": "datetime",
                  "synced_at": "datetime",
                  "created_at": "datetime"
                }
              ]
            }
          },
          "errors": {
            "401": "JWT manquant ou invalide",
            "400": "Format de date invalide pour ?since"
          }
        },
        {
          "method": "POST",
          "path": "/pomo/sync/projects",
          "description": "Envoyer un batch de projets. Résolution de conflits : last-write-wins sur updated_at.",
          "headers": {
            "Authorization": "Bearer {jwt_token}"
          },
          "body": {
            "projects": [
              {
                "uuid": "string (required)",
                "title": "string (required) — max 255 chars",
                "description": "string | null (optional)",
                "deadline": "datetime | null (optional)",
                "device_id": "string (required)",
                "deleted_at": "datetime | null (optional)",
                "updated_at": "datetime (required)"
              }
            ]
          },
          "response_success": {
            "http_status": 200,
            "body": {
              "synced": "integer",
              "conflicts_resolved": "integer"
            }
          },
          "errors": {
            "400": "Format de body invalide",
            "401": "JWT manquant ou invalide",
            "422": "Erreur de validation"
          }
        },
        {
          "method": "GET",
          "path": "/pomo/sync/stats",
          "description": "Récupérer les statistiques journalières DailyFocusStats (7 indicateurs) pour l'utilisateur.",
          "headers": {
            "Authorization": "Bearer {jwt_token}"
          },
          "query": {
            "since": "datetime (optional) — ISO 8601 UTC"
          },
          "response_success": {
            "http_status": 200,
            "body": {
              "stats": [
                {
                  "date": "date — YYYY-MM-DD",
                  "completion_rate": "float | null — 0.0–1.0",
                  "duration_accuracy": "float | null — 0.0–1.0",
                  "regularity": "float | null — 0.0–1.0",
                  "interruption_score": "float | null — 0.0–1.0",
                  "focus_score": "integer | null — 0–100",
                  "calculated_at": "datetime",
                  "device_id": "string",
                  "synced_at": "datetime"
                }
              ]
            }
          },
          "errors": {
            "401": "JWT manquant ou invalide",
            "400": "Format de date invalide pour ?since"
          }
        },
        {
          "method": "POST",
          "path": "/pomo/sync/stats",
          "description": "Envoyer un batch de statistiques DailyFocusStats. Unicité sur (user_id, date, device_id) — mise à jour si existant.",
          "headers": {
            "Authorization": "Bearer {jwt_token}"
          },
          "body": {
            "stats": [
              {
                "date": "date (required) — YYYY-MM-DD",
                "completion_rate": "float | null (optional)",
                "duration_accuracy": "float | null (optional)",
                "regularity": "float | null (optional)",
                "interruption_score": "float | null (optional)",
                "focus_score": "integer | null (optional) — 0–100",
                "calculated_at": "datetime (required)",
                "device_id": "string (required)"
              }
            ]
          },
          "response_success": {
            "http_status": 200,
            "body": {
              "synced": "integer",
              "conflicts_resolved": "integer"
            }
          },
          "errors": {
            "400": "Format de body invalide",
            "401": "JWT manquant ou invalide",
            "422": "Erreur de validation"
          }
        }
      ]
    },
    "stripe": {
      "description": "Phase 3 — Abonnement Premium via Stripe (futur)",
      "base_path": "/pomo",
      "routes": [
        {
          "method": "POST",
          "path": "/pomo/stripe/webhook",
          "description": "Webhook Stripe — reçoit les événements d'abonnement (payment_intent.succeeded, customer.subscription.deleted, etc.). Valide la signature Stripe-Signature avant tout traitement.",
          "auth_required": false,
          "headers": {
            "Stripe-Signature": "string (required) — signature HMAC-SHA256 générée par Stripe"
          },
          "body": "Payload JSON brut envoyé par Stripe",
          "response_success": {
            "http_status": 200,
            "body": {
              "received": true
            }
          },
          "errors": {
            "400": "Payload invalide ou signature manquante",
            "403": "Signature Stripe invalide"
          },
          "notes": [
            "La clé secrète webhook est dans la variable d'environnement STRIPE_WEBHOOK_SECRET",
            "Toujours retourner 200 rapidement — traitement asynchrone si nécessaire"
          ]
        }
      ]
    }
  },
  "db_tables": {
    "pomo_engagements": {
      "phase": "1A",
      "description": "Enregistrements d'engagement MVP (waitlist et sondage)",
      "columns": {
        "id": "INT AUTO_INCREMENT PRIMARY KEY",
        "type": "ENUM('waitlist','survey') NOT NULL",
        "device_id": "VARCHAR(36) NOT NULL",
        "email": "VARCHAR(254) NULL",
        "responses": "JSON NULL",
        "suggestion": "TEXT NULL",
        "platform": "ENUM('android','ios','web','windows','macos','linux') NULL",
        "language": "VARCHAR(16) NULL",
        "app_version": "VARCHAR(32) NULL",
        "build_number": "VARCHAR(32) NULL",
        "session_duration": "INT NULL",
        "network_status": "ENUM('online','offline') NULL",
        "timestamp_utc": "DATETIME NOT NULL",
        "created_at": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP"
      },
      "indexes": ["INDEX (type)", "INDEX (device_id)"],
      "notes": ["Unicité courriel pour waitlist gérée en code — MySQL ne supporte pas les partial unique indexes"]
    },
    "pomo_support_requests": {
      "phase": "1B",
      "description": "Demandes de support utilisateur",
      "columns": {
        "id": "INT AUTO_INCREMENT PRIMARY KEY",
        "user_id": "INT NULL — FK vers users.id, NULL prévu pour usage anonyme futur",
        "reference_id": "VARCHAR(36) NOT NULL — UUID unique de la demande",
        "email": "VARCHAR(254) NOT NULL",
        "message": "TEXT NOT NULL",
        "infos": "JSON NULL — informations contextuelles de l'appareil",
        "mail_sent": "TINYINT(1) NOT NULL DEFAULT 0",
        "confirmation_sent": "TINYINT(1) NOT NULL DEFAULT 0",
        "created_at": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP"
      }
    },
    "pomo_sessions": {
      "phase": "2",
      "description": "Sessions Pomodoro pour sync cloud",
      "columns": {
        "id": "INT AUTO_INCREMENT PRIMARY KEY",
        "uuid": "VARCHAR(36) UNIQUE NOT NULL",
        "user_id": "INT NOT NULL — FK vers users.id",
        "timestamp_utc": "DATETIME NOT NULL",
        "duration_sec": "INT NOT NULL",
        "interruptions": "INT NOT NULL DEFAULT 0",
        "task_uuid": "VARCHAR(36) NULL",
        "completed": "TINYINT(1) NOT NULL DEFAULT 0",
        "device_id": "VARCHAR(36) NOT NULL",
        "deleted_at": "DATETIME NULL",
        "updated_at": "DATETIME NOT NULL",
        "synced_at": "DATETIME NULL",
        "created_at": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP"
      }
    },
    "pomo_tasks": {
      "phase": "2",
      "description": "Tâches Pomodoro pour sync cloud",
      "columns": {
        "id": "INT AUTO_INCREMENT PRIMARY KEY",
        "uuid": "VARCHAR(36) UNIQUE NOT NULL",
        "user_id": "INT NOT NULL",
        "title": "VARCHAR(255) NOT NULL",
        "description": "TEXT NULL",
        "priority": "TINYINT NOT NULL DEFAULT 0",
        "status": "VARCHAR(32) NOT NULL",
        "estimated_pomodoros": "INT NULL",
        "project_uuid": "VARCHAR(36) NULL",
        "deadline": "DATETIME NULL",
        "order_index": "INT NOT NULL DEFAULT 0",
        "type": "VARCHAR(32) NOT NULL",
        "device_id": "VARCHAR(36) NOT NULL",
        "deleted_at": "DATETIME NULL",
        "updated_at": "DATETIME NOT NULL",
        "synced_at": "DATETIME NULL",
        "created_at": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP"
      }
    },
    "pomo_projects": {
      "phase": "2",
      "description": "Projets Pomodoro pour sync cloud",
      "columns": {
        "id": "INT AUTO_INCREMENT PRIMARY KEY",
        "uuid": "VARCHAR(36) UNIQUE NOT NULL",
        "user_id": "INT NOT NULL",
        "title": "VARCHAR(255) NOT NULL",
        "description": "TEXT NULL",
        "deadline": "DATETIME NULL",
        "device_id": "VARCHAR(36) NOT NULL",
        "deleted_at": "DATETIME NULL",
        "updated_at": "DATETIME NOT NULL",
        "synced_at": "DATETIME NULL",
        "created_at": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP"
      }
    },
    "pomo_daily_stats": {
      "phase": "2",
      "description": "Statistiques journalières DailyFocusStats (7 indicateurs)",
      "columns": {
        "id": "INT AUTO_INCREMENT PRIMARY KEY",
        "user_id": "INT NOT NULL",
        "date": "DATE NOT NULL",
        "completion_rate": "FLOAT NULL",
        "duration_accuracy": "FLOAT NULL",
        "regularity": "FLOAT NULL",
        "interruption_score": "FLOAT NULL",
