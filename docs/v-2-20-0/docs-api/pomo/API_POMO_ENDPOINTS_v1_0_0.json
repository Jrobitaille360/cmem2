{
  "api": {
    "name": "Pomo API",
    "version": "1.0.1",
    "description": "Plugin Pomodoro intégré dans cmem2 via le système de plugins. Seule la phase 1A (engagement MVP public) est implémentée. Les phases 1B (support), 2 (sync cloud) et 3 (Stripe) sont planifiées — spec retirée de ce fichier, voir le plan du projet et db_tables ci-dessous.",
    "generated": "2026-04-02",
    "reviewed": "2026-07-06",
    "base_url": "/pomo",
    "authentication": {
      "types": ["NONE"],
      "description": "Phase 1A : aucune authentification. Toute autre route /pomo/* répond 404."
    },
    "notes": [
      "GET /health est fourni par cmem2 core (PublicRouteHandler) — non redéfini dans ce plugin",
      "L'inscription et la connexion utilisent les endpoints cmem2 existants : POST /users/register et POST /auth/login",
      "Toutes les routes sont préfixées /pomo/ pour éviter toute collision avec le core",
      "Les tables db_tables marquées phase 1B/2/3 décrivent le schéma prévu pour les phases futures, pas des endpoints actifs"
    ]
  },
  "endpoints": {
    "public": {
      "description": "Phase 1A — Endpoints accessibles sans authentification",
      "base_path": "/pomo",
      "auth_required": false,
      "routes": [
        {
          "method": "POST",
          "path": "/pomo/engagement",
          "description": "Soumettre un engagement MVP — waitlist (courriel) ou sondage (5 questions oui/non/peut-être). Chaque soumission identifie l'appareil via device_id.",
          "body": {
            "type": "string (required) — 'waitlist' | 'survey'",
            "device_id": "string (required) — UUID stable côté client, max 36 chars",
            "email": "string (required si type=waitlist) — courriel valide, 3–254 chars",
            "responses": "object (required si type=survey) — clés q1 à q5, valeurs 'yes' | 'no' | 'maybe'",
            "suggestion": "string (optional) — texte libre, si type=survey",
            "platform": "string (optional) — 'android' | 'ios' | 'web' | 'windows' | 'macos' | 'linux'",
            "language": "string (optional) — code langue, max 16 chars",
            "app_version": "string (optional) — ex. '1.0.0', max 32 chars",
            "build_number": "string (optional) — ex. '42', max 32 chars",
            "session_duration": "integer (optional) — durée de la session en secondes",
            "network_status": "string (optional) — 'online' | 'offline'",
            "timestamp_utc": "datetime (required) — horodatage ISO 8601 UTC côté client"
          },
          "response_success": {
            "http_status": 201,
            "body": {
              "success": true,
              "reference_id": "integer — ID de l'enregistrement créé"
            }
          },
          "errors": {
            "409": "type=waitlist — courriel déjà enregistré dans la waitlist",
            "422": "Erreur de validation — corps : {success: false, errors: [{field, code, message}]}"
          },
          "notes": [
            "type=waitlist : un seul enregistrement par courriel (doublon → 409)",
            "type=survey : plusieurs soumissions par device_id acceptées",
            "Les 5 questions du sondage sont identifiées par des clés fixes q1–q5"
          ]
        }
      ]
    }
  },
  "db_tables": {
    "pomo_engagements": {
      "phase": "1A",
      "description": "Enregistrements d'engagement MVP (waitlist et sondage)",
      "columns": {
        "id": "INT AUTO_INCREMENT PRIMARY KEY",
        "type": "ENUM('waitlist','survey') NOT NULL",
        "device_id": "VARCHAR(36) NOT NULL",
        "email": "VARCHAR(254) NULL",
        "responses": "JSON NULL",
        "suggestion": "TEXT NULL",
        "platform": "ENUM('android','ios','web','windows','macos','linux') NULL",
        "language": "VARCHAR(16) NULL",
        "app_version": "VARCHAR(32) NULL",
        "build_number": "VARCHAR(32) NULL",
        "session_duration": "INT NULL",
        "network_status": "ENUM('online','offline') NULL",
        "timestamp_utc": "DATETIME NOT NULL",
        "created_at": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP"
      },
      "indexes": ["INDEX (type)", "INDEX (device_id)"],
      "notes": ["Unicité courriel pour waitlist gérée en code — MySQL ne supporte pas les partial unique indexes"]
    },
    "pomo_support_requests": {
      "phase": "1B",
      "description": "Demandes de support utilisateur",
      "columns": {
        "id": "INT AUTO_INCREMENT PRIMARY KEY",
        "user_id": "INT NULL — FK vers users.id, NULL prévu pour usage anonyme futur",
        "reference_id": "VARCHAR(36) NOT NULL — UUID unique de la demande",
        "email": "VARCHAR(254) NOT NULL",
        "message": "TEXT NOT NULL",
        "infos": "JSON NULL — informations contextuelles de l'appareil",
        "mail_sent": "TINYINT(1) NOT NULL DEFAULT 0",
        "confirmation_sent": "TINYINT(1) NOT NULL DEFAULT 0",
        "created_at": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP"
      }
    },
    "pomo_sessions": {
      "phase": "2",
      "description": "Sessions Pomodoro pour sync cloud",
      "columns": {
        "id": "INT AUTO_INCREMENT PRIMARY KEY",
        "uuid": "VARCHAR(36) UNIQUE NOT NULL",
        "user_id": "INT NOT NULL — FK vers users.id",
        "timestamp_utc": "DATETIME NOT NULL",
        "duration_sec": "INT NOT NULL",
        "interruptions": "INT NOT NULL DEFAULT 0",
        "task_uuid": "VARCHAR(36) NULL",
        "completed": "TINYINT(1) NOT NULL DEFAULT 0",
        "device_id": "VARCHAR(36) NOT NULL",
        "deleted_at": "DATETIME NULL",
        "updated_at": "DATETIME NOT NULL",
        "synced_at": "DATETIME NULL",
        "created_at": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP"
      }
    },
    "pomo_tasks": {
      "phase": "2",
      "description": "Tâches Pomodoro pour sync cloud",
      "columns": {
        "id": "INT AUTO_INCREMENT PRIMARY KEY",
        "uuid": "VARCHAR(36) UNIQUE NOT NULL",
        "user_id": "INT NOT NULL",
        "title": "VARCHAR(255) NOT NULL",
        "description": "TEXT NULL",
        "priority": "TINYINT NOT NULL DEFAULT 0",
        "status": "VARCHAR(32) NOT NULL",
        "estimated_pomodoros": "INT NULL",
        "project_uuid": "VARCHAR(36) NULL",
        "deadline": "DATETIME NULL",
        "order_index": "INT NOT NULL DEFAULT 0",
        "type": "VARCHAR(32) NOT NULL",
        "device_id": "VARCHAR(36) NOT NULL",
        "deleted_at": "DATETIME NULL",
        "updated_at": "DATETIME NOT NULL",
        "synced_at": "DATETIME NULL",
        "created_at": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP"
      }
    },
    "pomo_projects": {
      "phase": "2",
      "description": "Projets Pomodoro pour sync cloud",
      "columns": {
        "id": "INT AUTO_INCREMENT PRIMARY KEY",
        "uuid": "VARCHAR(36) UNIQUE NOT NULL",
        "user_id": "INT NOT NULL",
        "title": "VARCHAR(255) NOT NULL",
        "description": "TEXT NULL",
        "deadline": "DATETIME NULL",
        "device_id": "VARCHAR(36) NOT NULL",
        "deleted_at": "DATETIME NULL",
        "updated_at": "DATETIME NOT NULL",
        "synced_at": "DATETIME NULL",
        "created_at": "DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP"
      }
    },
    "pomo_daily_stats": {
      "phase": "2",
      "description": "Statistiques journalières DailyFocusStats (7 indicateurs)",
      "columns": {
        "id": "INT AUTO_INCREMENT PRIMARY KEY",
        "user_id": "INT NOT NULL",
        "date": "DATE NOT NULL",
        "completion_rate": "FLOAT NULL",
        "duration_accuracy": "FLOAT NULL",
        "regularity": "FLOAT NULL",
        "interruption_score": "FLOAT NULL",
        "focus_score": "TINYINT NULL",
        "calculated_at": "DATETIME NOT NULL",
        "device_id": "VARCHAR(36) NOT NULL",
        "synced_at": "DATETIME NULL"
      },
      "indexes": ["UNIQUE KEY (user_id, date, device_id)"]
    },
    "pomo_subscriptions": {
      "phase": "3",
      "description": "Abonnements Premium Stripe (futur)",
      "columns": {
        "migration": "004_pomo_subscriptions.sql — à définir"
      }
    }
  }
}
