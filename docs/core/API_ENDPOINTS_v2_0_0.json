{
  "api": {
    "name": "AuthGroups API",
    "version": "2.1.1",
    "description": "API REST complète pour la gestion d'authentification, groupes, fichiers, tags, calendriers ICS et CalDAV",
    "generated": "2026-03-27",
    "base_url": "/",
    "authentication": {
      "type": "JWT_BEARER",
      "header": "Authorization: Bearer {jwt_token}",
      "algorithm": "HS256",
      "expiry": "15 jours",
      "obtain": "POST /auth/login  ou  POST /auth/send-code + POST /auth/verify-code",
      "refresh": "POST /auth/refresh (device token longue durée — sans re-login)"
    },
    "breaking_changes_since_v1": [
      "Suppression de X-API-Key — remplacée par JWT Bearer",
      "POST /users/login supprimé — remplacé par POST /auth/login",
      "POST /users/logout supprimé — remplacé par POST /auth/logout",
      "Les API keys ne sont plus créées à l'inscription",
      "La réponse de /users/register ne contient plus api_key"
    ]
  },
  "endpoints": {
    "auth": {
      "description": "Authentification JWT — connexion, OTP, device tokens, logout",
      "base_path": "/auth",
      "routes": [
        {
          "method": "POST",
          "path": "/auth/login",
          "description": "Connexion par email + mot de passe — retourne un JWT (15 jours)",
          "auth_required": false,
          "body": {
            "email": "string (required)",
            "password": "string (required)",
            "device_id": "string (optional) — UUID stable côté client pour obtenir un device_token longue durée",
            "device_name": "string (optional) — nom lisible de l'appareil (défaut: User-Agent)"
          },
          "response": {
            "token": "string — JWT Bearer",
            "token_type": "Bearer",
            "expires_at": "datetime",
            "user": { "id": "integer", "name": "string", "email": "string", "role": "string" },
            "device_token": "string (présent uniquement si device_id fourni)",
            "device_id": "string (présent uniquement si device_id fourni)"
          },
          "errors": {
            "400": "Champs email ou password manquants / format invalide",
            "401": "Email ou mot de passe incorrect",
            "403": "Email non vérifié",
            "429": "Trop de tentatives — réessayez dans 10 minutes (5 max / 10 min par email+IP)"
          }
        },
        {
          "method": "POST",
          "path": "/auth/send-code",
          "description": "Envoyer un code OTP à 6 chiffres par email (valide 15 minutes)",
          "auth_required": false,
          "body": {
            "email": "string (required)"
          },
          "response": {
            "message": "string — réponse générique (même si email inconnu, pour protéger l'énumération)"
          },
          "errors": {
            "400": "Email manquant ou format invalide",
            "403": "Email non vérifié",
            "429": "Trop de tentatives — réessayez dans 10 minutes (5 max / 10 min par email+IP)"
          }
        },
        {
          "method": "POST",
          "path": "/auth/verify-code",
          "description": "Vérifier le code OTP et obtenir un JWT",
          "auth_required": false,
          "body": {
            "email": "string (required)",
            "code": "string (required) — code OTP à 6 chiffres",
            "device_id": "string (optional) — pour obtenir un device_token longue durée",
            "device_name": "string (optional)"
          },
          "response": {
            "token": "string — JWT Bearer",
            "token_type": "Bearer",
            "expires_at": "datetime",
            "user": { "id": "integer", "name": "string", "email": "string", "role": "string" },
            "device_token": "string (présent uniquement si device_id fourni)",
            "device_id": "string (présent uniquement si device_id fourni)"
          },
          "errors": {
            "400": "Champs manquants",
            "401": "Code incorrect, expiré ou déjà utilisé (max 5 tentatives)"
          }
        },
        {
          "method": "POST",
          "path": "/auth/refresh",
          "description": "Renouveler le JWT via un device token longue durée — sans re-login",
          "auth_required": false,
          "body": {
            "device_id": "string (required)",
            "device_token": "string (required)"
          },
          "response": {
            "token": "string — nouveau JWT Bearer",
            "token_type": "Bearer",
            "expires_at": "datetime",
            "user": { "id": "integer", "name": "string", "email": "string", "role": "string" },
            "device_token": "string — nouveau device token (l'ancien est révoqué, remplacer côté client)",
            "device_id": "string"
          },
          "errors": {
            "400": "device_id ou device_token manquant",
            "401": "Device token invalide, expiré ou révoqué"
          }
        },
        {
          "method": "GET",
          "path": "/auth/me",
          "description": "Obtenir les informations de l'utilisateur connecté via le JWT courant",
          "auth_required": true,
          "headers": {
            "Authorization": "Bearer {jwt_token}"
          },
          "response": {
            "user": { "id": "integer", "name": "string", "email": "string", "role": "string" }
          },
          "errors": {
            "401": "JWT manquant ou invalide"
          }
        },
        {
          "method": "POST",
          "path": "/auth/logout",
          "description": "Déconnexion — invalide la session en base (JWT reste valide côté serveur jusqu'à expiry, à supprimer côté client)",
          "auth_required": true,
          "headers": {
            "Authorization": "Bearer {jwt_token}"
          },
          "response": {
            "message": "string — confirmation"
          },
          "errors": {
            "401": "JWT manquant ou invalide"
          }
        },
        {
          "method": "GET",
          "path": "/auth/devices",
          "description": "Lister les appareils de confiance de l'utilisateur connecté",
          "auth_required": true,
          "headers": {
            "Authorization": "Bearer {jwt_token}"
          },
          "response": {
            "devices": [
              {
                "device_id": "string",
                "device_name": "string",
                "last_used_at": "datetime",
                "last_ip": "string",
                "expires_at": "datetime"
              }
            ]
          },
          "errors": {
            "401": "JWT manquant ou invalide"
          }
        },
        {
          "method": "DELETE",
          "path": "/auth/devices/{device_id}",
          "description": "Révoquer le device token d'un appareil",
          "auth_required": true,
          "headers": {
            "Authorization": "Bearer {jwt_token}"
          },
          "params": {
            "device_id": "string (required)"
          },
          "response": {
            "message": "string — confirmation"
          },
          "errors": {
            "401": "JWT manquant ou invalide"
          }
        }
      ]
    },
