{
    "name": "memories/cmem2-backend",
    "description": "Backend API pour l'application Memories v2",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "phpmailer/phpmailer": "^6.10",
        "simshaun/recurr": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "AuthGroups\\": "src/auth_groups/"
        },
        "files": [
            "src/auth_groups/database.php"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8080 index.php"
    },
    "config": {
        "optimize-autoloader": false
    }
}
