# ============================================================
# ENVIRONNEMENT
# ============================================================
APP_NAME=Collective Memories API
APP_VERSION=2.17.5
APP_TIMEZONE=America/Montreal
# â†“ Ã  ajuster selon l'environnement
APP_ENV=development
APP_DEBUG=true

# ============================================================
# BASE DE DONNÃ‰ES
# ============================================================
DB_PERSISTENT=false
DB_TIMEZONE=+00:00
# â†“ Ã  ajuster selon l'environnement
DB_HOST=localhost
DB_NAME=<nom-base-de-donnees>
DB_USER=<utilisateur-bd>
DB_PASS=<mot-de-passe-bd>

# ============================================================
# URLS ET ROUTAGE
# ============================================================
# â†“ Ã  ajuster selon l'environnement
APP_URL=http://localhost/cmem2_API
BASE_URL=http://localhost/cmem2_API
BASE_PATH=/cmem2_API
# BASE_PATH=          â† vide si API Ã  la racine du vhost (dev.online, prod)
ICS_BASE_URL=http://localhost/cmem2_API
# Front cmem_web — lien d'annulation booking public (/book/{slug}?cancel_token=...)
CMEMWEB_APP_URL=https://cmem-web.journauxdebord.com

# ============================================================
# CORS
# ============================================================
# â†“ Ã  ajuster selon l'environnement
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
ALLOWED_HEADERS=X-API-Key,Content-Type,Authorization,X-Requested-With,Accept,Origin

# ============================================================
# SECRETS
# ============================================================
JWT_SECRET=<secret-jwt-min-32-chars>
SECRET_ADMIN_ENDPOINT=<endpoint-secret-admin>
ADMIN_SECRET_KEY=<cle-secrete-admin>

# ============================================================
# EMAIL / SMTP
# ============================================================
EMAIL_SIMULATION=false
USE_SMTP=true
SMTP_HOST=<hote-smtp>
SMTP_PORT=587
SMTP_USERNAME=<utilisateur-smtp>
SMTP_PASSWORD=<mot-de-passe-smtp>
SMTP_SECURE=tls
MAIL_FROM_ADDRESS=<adresse-expediteur>
MAIL_FROM_NAME=Collective Memories

# ============================================================
# SÃ‰CURITÃ‰ ET RATE LIMITING
# ============================================================
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=60
ENABLE_REQUEST_LOGGING=true
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_WINDOW_MINUTES=10
# Delai de grace avant effacement physique d'un compte supprime (Loi 25)
ACCOUNT_PURGE_GRACE_DAYS=30
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Application en maintenance. Veuillez rÃ©essayer plus tard.

# ============================================================
# AUTHENTIFICATION â€” JWT, OTP, device tokens
# ============================================================
JWT_EXPIRY_DAYS=15
OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5
DEVICE_TOKEN_EXPIRY_DAYS=365
# Compte de test E2E a code OTP fixe (dev SEULEMENT — ne jamais definir en prod).
# send-code sur cet email : aucun email envoye, code fixe, exempt du rate limit.
# OTP_TEST_ACCOUNT_EMAIL=e2e@test.local
# OTP_TEST_ACCOUNT_CODE=000000
# Code OTP fixe pour TOUTE adresse (dev SEULEMENT - ne jamais definir en prod).
# send-code : aucun email envoye, code fixe, exempt du rate limit.
# Ignore si APP_ENV != development (un avertissement est journalise).
# AUTH_TEST_CODE=654321

# Reset de mot de passe par code (6 chiffres envoye par courriel)
PASSWORD_RESET_EXPIRY_MINUTES=60
PASSWORD_RESET_MAX_ATTEMPTS=5
# Code de reset de mot de passe fixe (dev SEULEMENT - ne jamais definir en prod).
# request-password-reset : aucun email envoye, code fixe, exempt du rate limit.
# PASSWORD_RESET_TEST_CODE=654321

# Verification de courriel par token (8 chiffres envoye par courriel)
EMAIL_VERIFICATION_EXPIRY_HOURS=24
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
# Token de verification fixe (dev SEULEMENT - ne jamais definir en prod).
# register / resend-verification-email : aucun email envoye, token fixe, exempt du rate limit.
# EMAIL_VERIFICATION_TEST_CODE=87654321

# ============================================================
# LOGS
# ============================================================
# â†“ Ã  ajuster selon l'environnement
LOG_LEVEL=debug
LOG_DIR=logs/
LOG_MAX_FILE_SIZE=10485760
LOG_ARCHIVE_AFTER_DAYS=7
LOG_DELETE_AFTER_WEEKS=12
LOG_TIMEZONE=America/Toronto
LOG_ROTATION_ENABLED=true
LOG_ROTATION_MAX_FILES=10
LOG_COMPRESS_ROTATED=true
LOG_PERFORMANCE=false
LOG_SLOW_QUERIES=true
SLOW_QUERY_THRESHOLD=1.0
LOG_SECURITY_EVENTS=true
LOG_FAILED_LOGINS=true
LOG_SUSPICIOUS_ACTIVITY=true
EMAIL_CRITICAL_LOGS=false
CRITICAL_LOG_EMAIL=
LOG_EMAIL_THRESHOLD=error

# ============================================================
# SAUVEGARDES
# ============================================================
BACKUP_PASSPHRASE=<passphrase-chiffrement-backups>
# â†“ Ã  ajuster selon l'environnement
BACKUP_DIR=<chemin-repertoire-backups>

# ============================================================
# UPLOADS
# ============================================================
UPLOAD_DIR=uploads/
TMP_ASSETS_DIR=tmp_assets/
MAX_IMAGE_SIZE=10485760
MAX_DOCUMENT_SIZE=10485760
MAX_AUDIO_SIZE=20971520
MAX_VIDEO_SIZE=52428800
MAX_EXECUTABLE_SIZE=209715200
# Plafond dur de POST /files en Mo (aligne sur upload_max_filesize)
FILES_MAX_UPLOAD_MB=100
MAX_AVATAR_SIZE=2097152
AVATAR_MAX_WIDTH=400
AVATAR_MAX_HEIGHT=400
ALLOWED_AVATAR_TYPES=image/jpeg,image/png,image/webp
MAX_GROUP_FILE_SIZE=10485760
MAX_FILES_PER_GROUP=100
ALLOWED_GROUP_DOCUMENT_TYPES=application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
MAX_GROUP_IMAGE_SIZE=5242880
GROUP_IMAGE_MAX_WIDTH=1200
GROUP_IMAGE_MAX_HEIGHT=600

# ============================================================
# TAGS
# ============================================================
MAX_TAGS_PER_ITEM=10
MAX_TAG_LENGTH=50
MIN_TAG_LENGTH=2
MAX_TAG_CATEGORIES=20
MAX_CATEGORY_NAME_LENGTH=30
DEFAULT_TAG_COLORS=#007bff,#28a745,#ffc107,#dc3545,#6f42c1,#fd7e14,#20c997,#6c757d
ALLOW_CUSTOM_TAG_COLORS=true
ALLOW_USER_CREATE_TAGS=true
REQUIRE_TAG_APPROVAL=false
ALLOW_TAG_SUGGESTIONS=true
TAG_SEARCH_MIN_LENGTH=1
TAG_SEARCH_MAX_RESULTS=50
ENABLE_TAG_AUTOCOMPLETE=true
TRACK_TAG_USAGE=true
TAG_TRENDING_PERIOD_DAYS=30
MAX_TRENDING_TAGS=20

# ============================================================
# PLUGIN ICS â€” defaults dans src/ics/config/ics_config.php
# ============================================================

# ============================================================
# PLUGIN TRAQUE
# ============================================================
# Compte systeme credite comme granted_by lors des attributions automatiques
# de role (ex. rang Maitre de Jeu au niveau 15). Doit exister dans users.
# Si absent ou 0, le joueur promu est inscrit comme son propre granted_by.
# TRAQUE_SYSTEM_USER_ID=1

# ============================================================
# PROXY IA - POST /ai/summarize (directive cmem_web ai-proxy)
# ============================================================
# Cle serveur uniquement - jamais transmise ni derivable cote client.
ANTHROPIC_API_KEY=<sk-ant-...>
# Modele configurable sans redeploiement front.
AI_SUMMARIZE_MODEL=claude-haiku-4-5

# ============================================================
# PLUGIN PUZZLE
# ============================================================
# â†“ Ã  ajuster selon l'environnement
PUZZLE_DEBUG_PREMIUM=false
PUZZLE_GOOGLE_SERVICE_ACCOUNT_JSON=<chemin/vers/google-service-account.json>
PUZZLE_UPLOAD_DIR=uploads/puzzle
PUZZLE_DEVICE_TOKEN_DAYS=365
PUZZLE_POLL_ACTIVE_WINDOW_SECONDS=10
PUZZLE_EVENT_RETENTION_HOURS=24
PUZZLE_SNAP_TOLERANCE=0.15
PUZZLE_HELD_TTL_SECONDS=30

# ============================================================
# STRIPE â€” Paiements et abonnements
# ============================================================
# â†“ Ã  ajuster selon l'environnement (sk_test_ en dev, sk_live_ en prod)
STRIPE_SECRET_KEY=<sk_test_... ou sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
STRIPE_PRICE_PUZZLE_MONTHLY=<price_...>
STRIPE_PRICE_PUZZLE_YEARLY=<price_...>
# Tenant cmemweb (client cmem_web) — mêmes price IDs que CMEM (voir docs/docs-api/stripe/TENANT_CMEMWEB.md)
STRIPE_PRICE_CMEMWEB_MONTHLY=<price_...>
STRIPE_PRICE_CMEMWEB_YEARLY=<price_...>
# Plan equipe (facturation de groupe, directive plan-equipe 20260813) - mensuel seulement en v1,
# prix provisoire 15$ CAD/mois documente dans docs/PLAN_plan-equipe.md
STRIPE_PRICE_CMEMWEB_TEAM=<price_...>
# Tenant xmgame (client XMGame, directive cmem #175) — à créer côté Stripe Dashboard (test + prod)
STRIPE_PRICE_XMGAME_MONTHLY=<price_...>
STRIPE_PRICE_XMGAME_YEARLY=<price_...>

# ============================================================
# WEB PUSH — Notifications navigateur (VAPID, RFC 8292)
# ============================================================
# Générer la paire : php src/push/generate_vapid.php
# La clé privée ne quitte jamais le serveur ; seule la publique est exposée
# par GET /push/vapid-public-key.
VAPID_PUBLIC_KEY=<clé publique base64url, 87 caractères>
VAPID_PRIVATE_KEY=<clé privée base64url, 43 caractères>
VAPID_SUBJECT=mailto:support@journauxdebord.com
# Titre et corps génériques : aucun détail d'entité n'est divulgué dans la notification
PUSH_GENERIC_TITLE=Rappel
PUSH_TTL_SECONDS=86400
# Optionnel — poste Windows/XAMPP sans magasin de CA : chemin d'un bundle CA pour les envois push
# PUSH_CA_BUNDLE=C:/xampp/apache/bin/curl-ca-bundle.crt
