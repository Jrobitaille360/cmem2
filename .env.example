# ============================================================
# CONFIGURATION — COLLECTIVE MEMORIES API
# ============================================================
# Copier ce fichier vers .env et ajuster les valeurs
# Les sections marquées ★ doivent être vérifiées à chaque
# déploiement (différences entre développement et production)

# ============================================================
# ★ ENVIRONNEMENT
# ============================================================
APP_ENV=development
APP_DEBUG=true

APP_NAME=Collective Memories API
APP_VERSION=2.4.0
APP_URL=http://localhost/cmem2_API
BASE_URL=http://localhost/cmem2_API
API_VERSION=v2
APP_TIMEZONE=America/Montreal

# ============================================================
# ★ BASE DE DONNÉES
# ============================================================
DB_HOST=localhost
DB_NAME=cmem2_db
DB_USER=root
DB_PASS=
DB_PERSISTENT=false
DB_TIMEZONE=+00:00

# ============================================================
# ★ CORS — Origines autorisées
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://localhost:5173,https://images_manager.journauxdebord.com
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
ALLOWED_HEADERS=X-API-Key,Content-Type,Authorization,X-Requested-With,Accept,Origin

# ============================================================
# ★ SECRETS — JWT et clés de sécurité (OBLIGATOIRE en prod)
# ============================================================
# Minimum 32 caractères, aléatoire
JWT_SECRET=changez_cette_cle_secrete_jwt_en_production_min32chars
# URL secrète pour le panneau d'administration
SECRET_ADMIN_ENDPOINT=super_secret_admin_endpoint_change_this_in_production
# Clé d'accès à l'API d'administration
ADMIN_SECRET_KEY=ultra_secret_admin_token_change_this_immediately_in_production

# ============================================================
# ★ EMAIL / SMTP
# ============================================================
USE_SMTP=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=
MAIL_FROM_ADDRESS=dev@localhost
MAIL_FROM_NAME=Collective Memories

# ============================================================
# ★ SAUVEGARDES
# ============================================================
BACKUP_PASSPHRASE=your_passphrase_here
BACKUP_DIR=/path/to/backup/

# ============================================================
# SÉCURITÉ — Rate limiting et maintenance
# ============================================================
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=60
ENABLE_REQUEST_LOGGING=true
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Application en maintenance. Veuillez réessayer plus tard.

# ============================================================
# AUTHENTIFICATION — Comportement et tokens
# ============================================================
JWT_EXPIRY_DAYS=15
OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5
DEVICE_TOKEN_EXPIRY_DAYS=365

AUTH_AUTO_LOGOUT_BEFORE_LOGIN=true
AUTH_AUTO_LOGOUT_LOG_LEVEL=info
AUTH_AUTO_LOGOUT_ALL_TOKENS=false
VALID_TOKEN_EXPIRATION=3600
VALID_TOKEN_CLEANUP_INTERVAL=1800

# ============================================================
# ADMINISTRATION — Session et sécurité
# ============================================================
ADMIN_SESSION_TIMEOUT=1800
ADMIN_MAX_FAILED_ATTEMPTS=3
ADMIN_LOCKOUT_DURATION=900
ADMIN_REQUIRE_IP_WHITELIST=false
ADMIN_ALLOWED_IPS=127.0.0.1,::1
LOG_ADMIN_ACCESS=true
LOG_ADMIN_ACTIONS=true
ADMIN_LOG_RETENTION_DAYS=90
ADMIN_REQUIRE_2FA=false
ADMIN_SESSION_REGENERATE_ID=true
ADMIN_CSRF_PROTECTION=true

# ============================================================
# UTILISATEURS ET GROUPES
# ============================================================
MAX_USERNAME_LENGTH=50
MIN_PASSWORD_LENGTH=8
REQUIRE_EMAIL_VERIFICATION=true
MAX_CONCURRENT_SESSIONS=5
SESSION_TIMEOUT=3600
GROUP_INVITATION_EXPIRATION=604800
MAX_GROUP_MEMBERS=50
MAX_GROUPS_PER_USER=10

# ============================================================
# LOGS ET MONITORING
# ============================================================
LOG_ENABLED=true
LOG_LEVEL=debug
LOG_DIR=logs/
LOG_MAX_FILE_SIZE=10485760
LOG_ARCHIVE_AFTER_DAYS=7
LOG_DELETE_AFTER_WEEKS=12
LOG_TIMEZONE=America/Toronto
LOG_ROTATION_ENABLED=true
LOG_ROTATION_MAX_FILES=10
LOG_COMPRESS_ROTATED=true
LOG_PERFORMANCE=false
LOG_SLOW_QUERIES=true
SLOW_QUERY_THRESHOLD=1.0
LOG_SECURITY_EVENTS=true
LOG_FAILED_LOGINS=true
LOG_SUSPICIOUS_ACTIVITY=true
EMAIL_CRITICAL_LOGS=false
CRITICAL_LOG_EMAIL=
LOG_EMAIL_THRESHOLD=error

# ============================================================
# UPLOADS — Fichiers, avatars, groupes
# ============================================================
UPLOAD_DIR=uploads/
TMP_ASSETS_DIR=tmp_assets/
MAX_FILE_SIZE=10485760
MAX_AVATAR_SIZE=2097152
AVATAR_MAX_WIDTH=400
AVATAR_MAX_HEIGHT=400
ALLOWED_AVATAR_TYPES=image/jpeg,image/png,image/webp
MAX_GROUP_FILE_SIZE=10485760
MAX_FILES_PER_GROUP=100
ALLOWED_GROUP_DOCUMENT_TYPES=application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document
MAX_GROUP_IMAGE_SIZE=5242880
GROUP_IMAGE_MAX_WIDTH=1200
GROUP_IMAGE_MAX_HEIGHT=600

# ============================================================
# TAGS ET CATÉGORIES
# ============================================================
MAX_TAGS_PER_ITEM=10
MAX_TAG_LENGTH=50
MIN_TAG_LENGTH=2
MAX_TAG_CATEGORIES=20
MAX_CATEGORY_NAME_LENGTH=30
DEFAULT_TAG_COLORS=#007bff,#28a745,#ffc107,#dc3545,#6f42c1,#fd7e14,#20c997,#6c757d
ALLOW_CUSTOM_TAG_COLORS=true
ALLOW_USER_CREATE_TAGS=true
REQUIRE_TAG_APPROVAL=false
ALLOW_TAG_SUGGESTIONS=true
TAG_SEARCH_MIN_LENGTH=1
TAG_SEARCH_MAX_RESULTS=50
ENABLE_TAG_AUTOCOMPLETE=true
TRACK_TAG_USAGE=true
TAG_TRENDING_PERIOD_DAYS=30
MAX_TRENDING_TAGS=20

# ============================================================
# PLUGIN PUZZLE
# ============================================================
# Bypass abonnement premium (dev uniquement — NE PAS activer en production)
# PUZZLE_DEBUG_PREMIUM=true

# ============================================================
# PLUGIN ICS — Calendriers (optionnel — les defaults sont dans
# src/ics/config/ics_config.php, décommentez pour surcharger)
# ============================================================
# ICS_BASE_URL=http://localhost/cmem2_API
# ICS_DEFAULT_TIMEZONE=America/Montreal
# ICS_LOG_LEVEL=DEBUG
# ICS_DEBUG_MODE=true
# ICS_ENABLE_PUBLIC_SHARING=true
# ICS_ENABLE_CACHE=false
# ICS_MAX_CALENDARS_PER_USER=100
# ICS_MAX_EVENTS_PER_CALENDAR=10000

# ============================================================
# STRIPE — Paiements et abonnements (v2.4.0+)
# ============================================================
# Clé secrète : Tableau de bord Stripe → Développeurs → Clés API
# Utiliser sk_test_... en développement, sk_live_... en production
STRIPE_SECRET_KEY=sk_test_...

# Secret de signature webhook : Tableau de bord Stripe → Développeurs → Webhooks
# → Ajouter endpoint https://votre-domaine.com/stripe/webhook
# → Événements : checkout.session.completed, customer.subscription.updated,
#                invoice.payment_succeeded, invoice.payment_failed,
#                customer.subscription.deleted
# → Révéler le secret de signature
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs de prix Stripe : Catalogue de produits → [Produit] → Prix → Copier l'ID
STRIPE_PRICE_PUZZLE_MONTHLY=price_...
STRIPE_PRICE_PUZZLE_YEARLY=price_...
